# Local "camus" from the PREBUILT Q4_K_M GGUF (made in Colab).
# Put this file next to camus-8b.Q4_K_M.gguf, then:  ollama create camus -f Modelfile
# (No -q flag — it's already quantized, so this needs only ~5GB RAM, not 16GB.)
FROM ./camus-8b.Q4_K_M.gguf

TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

PARAMETER temperature 0.6
PARAMETER top_k 40
PARAMETER min_p 0.05
PARAMETER repeat_penalty 1.1
PARAMETER num_ctx 4096
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
